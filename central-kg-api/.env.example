# Local Docker (default)
DATABASE_URL=postgresql+asyncpg://kg:kg@localhost:5432/kg

# Aiven (when ready). Use the SERVICE URI as `postgres://...` and swap the prefix:
# DATABASE_URL=postgresql+asyncpg://<user>:<pass>@<host>:<port>/<db>?ssl=require

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional — only needed for embeddings / vector search.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

LOG_LEVEL=INFO
