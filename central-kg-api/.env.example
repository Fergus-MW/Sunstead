# Local Docker (default)
DATABASE_URL=postgresql+asyncpg://kg:kg@localhost:5432/kg

# Aiven (when ready). Use the SERVICE URI as `postgres://...` and swap the prefix:
# DATABASE_URL=postgresql+asyncpg://<user>:<pass>@<host>:<port>/<db>?ssl=require

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Embedding dimension reserved in the schema for forward compatibility.
# Anthropic ships no embeddings API today, so the column stays NULL until a
# Voyage / sentence-transformers adapter is wired up — search falls back to
# trigram + keyword.
EMBEDDING_DIM=1536

LOG_LEVEL=INFO
