# Base URL of central-kg-api (the FastAPI knowledge-graph service).
# Used server-side by the /api/graph/* proxy routes; never exposed to the browser.
# Local dev default is http://localhost:8000; point at the Lambda/ECS URL in prod.
KG_API_URL=http://localhost:8000

# Base URL of the agent-system gateway (POST /tasks). Server-side only — used by
# the /api/tasks proxy. Local default matches `make gateway` (port 8800).
GATEWAY_URL=http://localhost:8800

# WebSocket URL of the gateway's live feed (WS /stream). This one IS exposed to
# the browser (NEXT_PUBLIC_), since the WS connects directly from the client.
# Use wss:// in production.
NEXT_PUBLIC_GATEWAY_WS_URL=ws://localhost:8800/stream

# Avatar-agent dispatch endpoint (the Lambda Function URL, or the single-EC2
# dispatch route). Server-side only — /api/join POSTs the Meet link here to send
# the avatar bot into the call. Leave empty to acknowledge joins without sending a
# real bot (dev / demoing the dashboard without the realtime layer online).
AVATAR_DISPATCH_URL=
