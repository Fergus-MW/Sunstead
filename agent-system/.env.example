# Copy to .env and fill in. Defaults are LOCAL-FIRST (redpanda + local mcp-aiven).
# Never commit the real .env.

# --- Anthropic (the agents' LLM) ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=                 # optional (e.g. a gateway); leave blank for direct
MODEL_SMART=claude-opus-4-8         # hard reasoning
MODEL_FAST=claude-haiku-4-5         # fast lookups / phrasing

# --- Aiven MCP (local mcp-aiven over stdio; the agents' ONLY data-plane path) ---
AIVEN_TOKEN=                        # https://console.aiven.io/profile/tokens
AIVEN_SERVICES_SCOPE=pg,kafka       # limit the MCP's blast radius
AIVEN_READ_ONLY=false
# MCP_AIVEN_CMD=npx                 # override if needed (auto: npx.cmd on Windows)
# MCP_AIVEN_ARGS=-y mcp-aiven

# --- Kafka: LOCAL default (redpanda via `make up`) ---
KAFKA_BOOTSTRAP=localhost:19092
KAFKA_SECURITY=PLAINTEXT
KAFKA_PARTITIONS=1
KAFKA_RF=1

# --- Kafka: AIVEN (uncomment + fill to point at the cloud cluster) ---
# KAFKA_BOOTSTRAP=<service>-<project>.aivencloud.com:<port>
# KAFKA_SECURITY=SASL_SSL           # or SSL (mTLS)
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_USERNAME=avnadmin
# KAFKA_PASSWORD=
# KAFKA_CA_PATH=./ca.pem
# KAFKA_CERT_PATH=./service.cert    # mTLS only
# KAFKA_KEY_PATH=./service.key      # mTLS only
# KAFKA_PARTITIONS=3
# KAFKA_RF=3

# --- Runner ---
CONSUMER_GROUP=agent-runner
MAX_CONCURRENCY=8
SESSIONS_DIR=./.sessions

# --- Web agent (later) ---
VERCEL_TOKEN=
