# Copy to .env and fill in. Defaults are LOCAL-FIRST (redpanda + local mcp-aiven).
# Never commit the real .env.
# NOTE: keep comments on their OWN lines — an inline "KEY=val  # note" is parsed
# as part of the value by python-dotenv and will corrupt the setting.

# --- Anthropic (the agents' LLM) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL — optional LLM gateway. Leave COMMENTED OUT for the direct API.
# Do NOT set it empty: docker compose's env_file passes "" through, and the Anthropic
# SDK treats an empty base URL as a protocol-less URL → a misleading "Connection error".
# ANTHROPIC_BASE_URL=https://your-gateway.example/v1
MODEL_SMART=claude-opus-4-8
MODEL_FAST=claude-haiku-4-5

# --- Aiven MCP (local mcp-aiven over stdio; the agents' data-plane path) ---
# Token: https://console.aiven.io/profile/tokens
# Requires the org's "Allow MCP connection" (Console > Admin settings > Authentication).
AIVEN_TOKEN=
AIVEN_SERVICES_SCOPE=pg,kafka
AIVEN_READ_ONLY=false
# MCP_AIVEN_CMD=npx
# MCP_AIVEN_ARGS=-y mcp-aiven

# --- Kafka: LOCAL default (redpanda via `make up`) ---
# Running on the HOST (make run / make planner): localhost:19092 (below).
# Running via `docker compose up` (make stack): compose overrides this to redpanda:9092
#   (the in-network address) for you — leave the host value here untouched.
KAFKA_BOOTSTRAP=localhost:19092
KAFKA_SECURITY=PLAINTEXT
KAFKA_PARTITIONS=1
KAFKA_RF=1

# --- Kafka: AIVEN (uncomment + fill to point at the cloud cluster; SASL_SSL or SSL/mTLS) ---
# KAFKA_BOOTSTRAP=<service>-<project>.aivencloud.com:<port>
# KAFKA_SECURITY=SASL_SSL
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_USERNAME=avnadmin
# KAFKA_PASSWORD=
# KAFKA_CA_PATH=./ca.pem
# KAFKA_CERT_PATH=./service.cert
# KAFKA_KEY_PATH=./service.key
# KAFKA_PARTITIONS=3
# KAFKA_RF=3

# --- Runner ---
CONSUMER_GROUP=agent-runner
MAX_CONCURRENCY=8
SESSIONS_DIR=./.sessions

# --- Web agent ---
# Self-contained demo deployer: Claude writes a one-file site to SITES_DIR, served by
# `make sites` (scripts/serve_sites.py) at SITES_BASE_URL. No Vercel token needed for the demo.
SITES_DIR=./.sites
SITES_PORT=8810
SITES_BASE_URL=http://localhost:8810
# VERCEL_TOKEN — set to swap the local server for a real Vercel deploy.
VERCEL_TOKEN=

# --- central-kg-api (only for `make stack-full` / the `full` compose profile) ---
# The graph API reads this. Local Postgres or the Aiven service URI (swap the prefix to
# postgresql+asyncpg:// and add ?ssl=require). Leave unset if you run kg-api separately.
# DATABASE_URL=postgresql+asyncpg://<user>:<pass>@<host>:<port>/<db>?ssl=require
