# --- Anthropic ---
ANTHROPIC_API_KEY=
# Optional: route via Vercel AI Gateway instead of calling Anthropic directly
AI_GATEWAY_API_KEY=
ANTHROPIC_BASE_URL=

# --- Call pipeline ---
RECALL_API_KEY=
RECALL_REGION=us-east-1
SONIOX_API_KEY=
SONIOX_MODEL=stt-rt-v5
TTS_API_KEY=

# --- Kafka (Aiven) ---
KAFKA_BOOTSTRAP=
KAFKA_SECURITY=SASL_SSL          # SASL_SSL (recommended) or SSL (mTLS)
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=
KAFKA_CA_PATH=./ca.pem
# mTLS alternative (if KAFKA_SECURITY=SSL):
KAFKA_CERT_PATH=./service.cert
KAFKA_KEY_PATH=./service.key

# --- Knowledge graph (teammate's central-kg-api) ---
KG_BASE_URL=http://localhost:8000
KG_STUB=false                    # true => kg_client returns canned results (dev w/o KG)

# --- Web agent ---
VERCEL_TOKEN=
