# Copy to .env and fill in. Defaults are LOCAL-FIRST (redpanda + local mcp-aiven).
# Never commit the real .env.
# NOTE: keep comments on their OWN lines — an inline "KEY=val  # note" is parsed
# as part of the value by python-dotenv and will corrupt the setting.

# --- Anthropic (the agents' LLM) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL — optional gateway; leave UNSET for the direct API.
ANTHROPIC_BASE_URL=
MODEL_SMART=claude-opus-4-8
MODEL_FAST=claude-haiku-4-5

# --- Aiven MCP (local mcp-aiven over stdio; the agents' data-plane path) ---
# Token: https://console.aiven.io/profile/tokens
# Requires the org's "Allow MCP connection" (Console > Admin settings > Authentication).
AIVEN_TOKEN=
AIVEN_SERVICES_SCOPE=pg,kafka
AIVEN_READ_ONLY=false
# MCP_AIVEN_CMD=npx
# MCP_AIVEN_ARGS=-y mcp-aiven

# --- Kafka: LOCAL default (redpanda via `make up`) ---
KAFKA_BOOTSTRAP=localhost:19092
KAFKA_SECURITY=PLAINTEXT
KAFKA_PARTITIONS=1
KAFKA_RF=1

# --- Kafka: AIVEN (uncomment + fill to point at the cloud cluster; SASL_SSL or SSL/mTLS) ---
# KAFKA_BOOTSTRAP=<service>-<project>.aivencloud.com:<port>
# KAFKA_SECURITY=SASL_SSL
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_USERNAME=avnadmin
# KAFKA_PASSWORD=
# KAFKA_CA_PATH=./ca.pem
# KAFKA_CERT_PATH=./service.cert
# KAFKA_KEY_PATH=./service.key
# KAFKA_PARTITIONS=3
# KAFKA_RF=3

# --- Runner ---
CONSUMER_GROUP=agent-runner
MAX_CONCURRENCY=8
SESSIONS_DIR=./.sessions

# --- Web agent (later) ---
VERCEL_TOKEN=
