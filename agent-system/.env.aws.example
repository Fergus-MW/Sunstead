# Sunstead agent suite — AWS/EC2 deploy env (Aiven Kafka mTLS + Cloudflare Tunnel).
# Copy to .env ON THE EC2 BOX (cp .env.aws.example .env), fill the 4 secret values, never commit it.
# Cert paths below are the IN-CONTAINER mount points (docker-compose.aiven.yml mounts ./ca.pem -> /app/ca.pem).

# --- Anthropic (the agents' LLM) ---  [FILL]
ANTHROPIC_API_KEY=
MODEL_SMART=claude-opus-4-8
MODEL_FAST=claude-haiku-4-5

# --- Aiven MCP (data-plane: aiven_pg_read/write) ---  [FILL]
AIVEN_TOKEN=
AIVEN_SERVICES_SCOPE=pg,kafka
AIVEN_READ_ONLY=false

# --- Aiven Kafka (mTLS / certificate auth — NOT SASL) ---  [prefilled]
KAFKA_BOOTSTRAP=kafka-254bd14f-jq01.h.aivencloud.com:28095
KAFKA_SECURITY=SSL
KAFKA_CA_PATH=/app/ca.pem
KAFKA_CERT_PATH=/app/service.cert
KAFKA_KEY_PATH=/app/service.key
KAFKA_PARTITIONS=3
KAFKA_RF=3

# --- Runner ---
# CONSUMER_GROUP: use a UNIQUE value if another deployment shares this Aiven cluster,
# otherwise the two runners split partitions and each sees only some tasks.
CONSUMER_GROUP=agent-runner-aws
MAX_CONCURRENCY=8

# --- Web-agent artifacts (served via the sites tunnel hostname) ---  [FILL domain]
SITES_DIR=./.sites
SITES_PORT=8810
SITES_BASE_URL=https://sites.<your-domain>
# Or publish to Vercel instead (then sites/:8810 + its tunnel hostname aren't needed):
# VERCEL_TOKEN=
# VERCEL_PROJECT=sunstead-sites

# --- Cloudflare Tunnel ---  [FILL]
CLOUDFLARE_TUNNEL_TOKEN=
