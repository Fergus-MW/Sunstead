# ─── Meeting transport (Recall.ai) ────────────────────────────────────────────
RECALL_API_KEY=
# Region your Recall workspace lives in: us-east-1 | us-west-2 | eu-central-1 | …
RECALL_REGION=us-east-1
# Display name the bot uses in the participant list.
BOT_NAME=Sunstead Avatar

# ─── LiveKit (orchestration transport) ────────────────────────────────────────
# LiveKit Cloud project URL + key/secret. The worker connects here; the Recall
# viewer page joins the same room to capture/render media.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Public URL of the avatar viewer page (viewer/index.html), hosted somewhere
# Recall's browser can reach. The dispatcher appends ?lk=…&token=… per meeting.
VIEWER_URL=https://your-host.example.com/viewer/

# ─── Avatar (Anam) ────────────────────────────────────────────────────────────
# API key from the Anam dashboard. ANAM_API_TOKEN is also accepted (the name used
# in the shared repo-root .env vault) — set either one.
ANAM_API_KEY=
# REQUIRED: the avatar/persona id to render, from the Anam dashboard (lab.anam.ai).
# Without it the worker exits with a clear "ANAM_AVATAR_ID is not set" error.
ANAM_AVATAR_ID=
ANAM_AVATAR_NAME=Sunstead

# ─── Cognition pipeline ───────────────────────────────────────────────────────
# "realtime" = OpenAI Realtime single speech-to-speech model (lowest latency,
#              one key — the default). Only OPENAI_API_KEY below is needed.
# "cascade"  = streaming STT -> Anthropic LLM -> streaming TTS (per-leg latency
#              metrics, Anthropic-native). Needs the STT/Anthropic/Cartesia keys.
PIPELINE_MODE=realtime

# Anthropic (cascade LLM). Sonnet 4.6 is the latency/quality default for a
# conversational meeting agent; bump to claude-opus-4-8 for harder reasoning.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Streaming STT leg (cascade). STT_PROVIDER picks the engine:
#   "soniox"   = Soniox real-time (default; streaming, needs SONIOX_API_KEY).
#   "deepgram" = Deepgram (needs DEEPGRAM_API_KEY + STT_MODEL).
STT_PROVIDER=soniox
SONIOX_API_KEY=
SONIOX_MODEL=stt-rt-v5
SONIOX_LANGUAGE_HINTS=en
# Deepgram (only if STT_PROVIDER=deepgram).
DEEPGRAM_API_KEY=
STT_MODEL=nova-3

# Streaming TTS leg (cascade).
CARTESIA_API_KEY=
TTS_VOICE=

# OpenAI (realtime pipeline only).
OPENAI_API_KEY=
REALTIME_VOICE=alloy

# ─── Backend API (the custom tools call this) ─────────────────────────────────
# In Sunstead this is the central-kg-api. Tools issue authenticated HTTPS calls.
BACKEND_URL=http://localhost:8000
BACKEND_TOKEN=
# Per-call timeout (seconds). The PRD target is <=0.3s to stay in the latency
# budget; relaxed here for local dev against a cold backend.
BACKEND_TIMEOUT=5.0

# ─── Delegation gateway (avatar → worker-suite seam, DESIGN §3 option a) ───────
# The agent-system gateway's base URL. The `delegate` tool POSTs /tasks here to
# hand heavy work (build a site, dig into git, analyze data) to the async worker
# suite over Kafka. Leave empty to disable delegation (the tool degrades and says
# it can't dispatch). The gateway defaults to port 8800 (see agent-system).
GATEWAY_URL=http://localhost:8800
GATEWAY_TOKEN=
GATEWAY_TIMEOUT=5.0

# Single delegation brain (DESIGN §6). Default false: the avatar EMITS each final user
# utterance to the gateway's /transcript → meeting.transcript, and the planner does all
# routing (same path as `make mock`). Set true to instead give the avatar a delegate()
# tool that dispatches work itself — if you do, run the planner OFF or both will delegate
# the same utterance. Either way the avatar still emits transcript (lights up the FE feed).
AVATAR_DELEGATES=false

# ─── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Directory where per-call transcript + tool-call timeline artifacts are written.
ARTIFACT_DIR=./artifacts
