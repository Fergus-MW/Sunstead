# Dispatch Lambda (container image). Kept minimal — it only needs the LiveKit
# token signer + an HTTP client, NOT the full livekit-agents runtime.
FROM public.ecr.aws/lambda/python:3.11

# Slim dependency set for the dispatch path only.
RUN pip install --no-cache-dir \
    "livekit-api>=0.8" \
    "httpx>=0.27" \
    "pydantic>=2.7" \
    "pydantic-settings>=2.4" \
    "python-dotenv>=1.0"

# Ship just the modules the handler imports (config, recall, dispatch, handler).
COPY src/avatar_agent/__init__.py ${LAMBDA_TASK_ROOT}/avatar_agent/__init__.py
COPY src/avatar_agent/config.py ${LAMBDA_TASK_ROOT}/avatar_agent/config.py
COPY src/avatar_agent/recall.py ${LAMBDA_TASK_ROOT}/avatar_agent/recall.py
COPY src/avatar_agent/dispatch.py ${LAMBDA_TASK_ROOT}/avatar_agent/dispatch.py
COPY src/avatar_agent/lambda_dispatch.py ${LAMBDA_TASK_ROOT}/avatar_agent/lambda_dispatch.py

CMD ["avatar_agent.lambda_dispatch.handler"]
